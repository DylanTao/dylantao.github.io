{% assign home = site.pages | where: 'permalink', '/' | first %}
{% assign origin_photo = home.thesis.origin.photo %}
{% assign notebook_root_url = '/' | relative_url %}
{% assign notebook_news_href = 'href="' | append: notebook_root_url %}
<link rel="stylesheet" href="{{ '/assets/css/design-lab.css' | relative_url }}">

<div class="home-page design-lab">
  <header class="design-lab-opening">
    <p class="home-kicker">Research and design</p>
    <h1>Design notebook.</h1>
    <p>DesignWeaver, papers I return to, and a little La Jolla.</p>
    <nav aria-label="In the design notebook">
      <a href="#work">Work</a>
      <a href="#thesis">The research thread</a>
      <a href="#updates">Updates</a>
      <a href="#papers">Papers</a>
      <a href="#designweaver">Inside DesignWeaver</a>
      <a href="#miniature">Making the miniature</a>
      <a href="{{ '/' | relative_url }}">About me ↗</a>
    </nav>
  </header>

  <section id="work" class="design-preview" aria-labelledby="notebook-work-title">
    <div class="design-preview-surface design-work-spread">
      <div class="home-section-heading home-section-heading-row">
        <div>
          <p class="home-kicker">Selected work</p>
          <h2 id="notebook-work-title">Questions made tangible.</h2>
        </div>
        <a class="home-text-link" href="{{ '/projects/' | relative_url }}">All projects</a>
      </div>
      {% for work in home.featured_work %}
        <article class="design-work-row">
          <div class="design-work-copy">
            <p class="home-work-meta">
              <span>{{ work.venue }}</span><span>{{ work.theme }}</span>
            </p>
            <h3>
              <a href="{{ work.url | relative_url }}">{{ work.title }}</a>
            </h3>
            <p>{{ work.description }}</p>
            <a class="home-text-link" href="{{ work.url | relative_url }}">Read the case study ↗</a>
          </div>
          <figure>
            <a href="{{ work.url | relative_url }}" aria-label="Open {{ work.title }} case study">
              <img
                src="{{ work.image | relative_url }}"
                alt="{{ work.alt }}"
                width="{{ work.image_width }}"
                height="{{ work.image_height }}"
                loading="lazy"
              >
            </a>
          </figure>
        </article>
      {% endfor %}
    </div>
  </section>

  <section id="thesis" class="design-preview" aria-labelledby="notebook-thesis-title">
    <div class="design-preview-surface design-conversation">
      <div class="design-conversation-copy">
        <p class="home-kicker">{{ home.thesis.eyebrow }}</p>
        <h2 id="notebook-thesis-title">{{ home.thesis.title }}</h2>
        <p class="design-thesis-lead">{{ home.thesis.lead }}</p>
        <aside class="design-principle" aria-label="Sirui's design principle">
          <p class="design-preview-label">{{ home.thesis.principle_label }}</p>
          <p>{{ home.thesis.principle }}</p>
        </aside>
        <p class="design-conversation-credit">{{ home.thesis.origin.text }}</p>
      </div>
      <aside class="design-conversation-margin" aria-label="One of the conversations behind this work">
        {% capture origin_caption %}{{ origin_photo.caption }}<br>{{ origin_photo.date_label }}{% endcapture %}
        {%
          include figure.liquid
          path=origin_photo.image
          alt=origin_photo.alt
          width=origin_photo.width
          height=origin_photo.height
          caption=origin_caption
          sizes='(max-width: 767px) 192px, 208px'
          loading='lazy'
        %}
        <a class="home-text-link" href="{{ home.thesis.origin.url | relative_url }}">Read the talk note ↗</a>
      </aside>
    </div>
  </section>

  <section id="updates" class="design-preview" aria-labelledby="notebook-updates-title">
    <div class="design-preview-surface">
      <div class="home-section-heading home-section-heading-row">
        <div>
          <p class="home-kicker">Updates</p>
          <h2 id="notebook-updates-title">Recent signals.</h2>
        </div>
        <a class="home-text-link" href="{{ '/news/' | relative_url }}">Full timeline</a>
      </div>
      {% assign pinned_news = site.news | where: 'pinned', true | sort: 'date' | reverse %}
      {% assign regular_news = site.news | where_exp: 'item', 'item.pinned != true' | sort: 'date' | reverse %}
      {% assign preview_news = pinned_news | concat: regular_news %}
      <div class="home-news-strip">
        {% for item in preview_news limit: home.announcements.limit %}
          <article class="home-news-item">
            <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <p>
              {% if item.pinned -%}
                <span class="home-news-pin" aria-label="Pinned">Pinned</span>
              {%- endif %}
              {% if item.inline -%}
                {{- item.content | remove: '<p>' | remove: '</p>' | emojify | replace: 'href="/', notebook_news_href -}}
              {%- else -%}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {%- endif %}
            </p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="papers" class="design-preview" aria-labelledby="notebook-papers-title">
    <div class="design-preview-surface">
      <div class="home-section-heading">
        <p class="home-kicker">Selected publications</p>
        <h2 id="notebook-papers-title">Papers worth opening first.</h2>
      </div>
      <div class="design-reading-list">
        {% for paper in page.reading_list %}
          {% assign context = site.data.publication_context.papers[paper.key] %}
          <article class="design-reading-row">
            <div>
              <h3>
                <a
                  href="{% if paper.url contains '://' %}{{ paper.url }}{% else %}{{ paper.url | relative_url }}{% endif %}"
                  {% if paper.url contains '://' %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                >
                  {{- paper.title }}
                  <span aria-hidden="true">↗</span></a
                >
              </h3>
              <p class="design-reading-meta">
                {{ paper.venue -}}
                <br>
                {{ context.authorship.role_label }}
              </p>
            </div>
            <p class="design-reading-purpose">{{ context.human.fit }}</p>
          </article>
        {% endfor %}
      </div>
      <a class="home-text-link design-reading-archive" href="{{ '/publications/' | relative_url }}">Full bibliography, authors &amp; resources ↗</a>
    </div>
  </section>

  <section id="designweaver" class="design-preview" aria-labelledby="notebook-designweaver-title">
    <header class="design-preview-brief">
      <div>
        <p class="design-preview-label">Research notes</p>
        <h2 id="notebook-designweaver-title">Inside DesignWeaver.</h2>
        <p>Follow the design process and inspect the evidence from the study.</p>
      </div>
    </header>
    <div class="design-preview-surface design-reading-list">
      <article class="design-reading-row">
        <div>
          <h3>
            <a href="{{ '/design-lab/case-process/' | relative_url }}">Follow the process <span aria-hidden="true">↗</span></a>
          </h3>
          <p class="design-reading-meta">Numbered steps beside the full diagram</p>
        </div>
        <p class="design-reading-purpose">From the design brief to generated images, with the full system diagram.</p>
      </article>
      <article class="design-reading-row">
        <div>
          <h3>
            <a href="{{ '/design-lab/case-comparison/' | relative_url }}">Compare the interfaces <span aria-hidden="true">↗</span></a>
          </h3>
          <p class="design-reading-meta">Baseline, DesignWeaver, and study evidence</p>
        </div>
        <p class="design-reading-purpose">Compare the study interfaces and inspect participant ratings and image-diversity results.</p>
      </article>
    </div>
  </section>

  <section id="miniature" class="design-preview" aria-labelledby="notebook-coastal-title">
    <header class="design-preview-brief">
      <div>
        <p class="design-preview-label">Making the miniature</p>
        <h2 id="notebook-coastal-title">A little La Jolla.</h2>
        <p>Generated studies, a reconstructed shape, and the architecture I built for the miniature.</p>
      </div>
    </header>
    <div class="design-preview-surface">
      <article class="design-reading-row">
        <div>
          <h3>
            <a href="{{ '/design-lab/coastal-process/' | relative_url }}">From reference to geometry <span aria-hidden="true">↗</span></a>
          </h3>
          <p class="design-reading-meta">Generated studies → reconstruction → authored geometry</p>
        </div>
        <p class="design-reading-purpose">See what the reconstruction recovered and which architectural details needed deliberate modeling.</p>
      </article>
    </div>
  </section>
</div>
