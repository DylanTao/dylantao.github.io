{% unless page.ai_profile or page.redirect or page.secret_globe %}
  <figure class="footer-coast" id="la-jolla" data-footer-coast data-state="still">
    <div
      class="footer-coast__scene"
      role="img"
      aria-label="La Jolla in miniature: Spanish houses and a villa above sandstone cliffs, palms, tennis, beach volleyball, Pacific surfers, and the folded glass bays of UC San Diego's Design and Innovation Building."
    >
      <img
        class="footer-coast__poster"
        src="{{ '/assets/models/la-jolla/poster.webp' | relative_url }}"
        width="2000"
        height="620"
        loading="lazy"
        decoding="async"
        alt=""
        aria-hidden="true"
      >
      <canvas class="footer-coast__canvas" aria-hidden="true"></canvas>
    </div>
    <figcaption class="footer-coast__caption">
      <span>One little corner of La Jolla.<span class="footer-coast__hint"> Swipe to wander.</span></span>
      <div class="footer-coast__actions" hidden>
        <button
          type="button"
          class="footer-coast__light"
          aria-pressed="true"
          title="A little light in my third-floor corner of the Design and Innovation Building"
        >
          <span class="footer-coast__lamp" aria-hidden="true"></span>
          <span data-coast-light-label>Studio light on</span>
        </button>
        <button type="button" class="footer-coast__pause" aria-label="Pause coastal scene" aria-pressed="false">
          <span data-coast-pause-icon aria-hidden="true">Ⅱ</span>
        </button>
      </div>
    </figcaption>
    <script type="module" src="{{ '/assets/js/footer-coast/entry.mjs' | relative_url | bust_file_cache }}"></script>
  </figure>
{% endunless %}
