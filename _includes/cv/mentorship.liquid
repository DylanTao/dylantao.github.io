{% comment %}
  Research mentorship entry renderer for current and alumni mentees
{% endcomment %}

{% assign mentorship_statuses = 'current,alumni' | split: ',' %}
{% for mentorship_status in mentorship_statuses %}
  {% assign grouped_entries = entries | where: 'status', mentorship_status %}
  {% if grouped_entries.size > 0 %}
    <h4 class="font-weight-medium ml-1 ml-md-4 mt-3">{{ mentorship_status | capitalize }}</h4>
    <ul class="card-text font-weight-light list-group list-group-flush">
      {% for entry in grouped_entries %}
        <li class="list-group-item">
          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ entry.name }}</a>
            </h6>
          {% else %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.name }}</h6>
          {% endif %}

          {% capture details_line %}
            {% if entry.details %}{{ entry.details }}{% endif %}
            {% if entry.paperLabel and entry.paperAnchor %}
              {% if entry.details %} {% endif %}
              <a href="#{{ entry.paperAnchor }}">[{{ entry.paperLabel }}]</a>
            {% endif %}
          {% endcapture %}
          {% assign details_line = details_line | strip %}
          {% if details_line != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ details_line }}</h6>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endfor %}

<p class="font-weight-light ml-1 ml-md-4 mt-3">
  Fun fact: every intern I’ve mentored so far has worked on <a href="#cv-publication-p5">[P5]</a>, the twice-rejected paper. Hopefully the rejection
  streak ends soon :-)
</p>
