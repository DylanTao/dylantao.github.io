{% assign widget_origin_label = include.label | default: 'Read how this came to be' %}
<a
  class="widget-origin-link{% if include.class %} {{ include.class }}{% endif %}"
  href="{{ include.href | relative_url }}"
  aria-label="{{ widget_origin_label }}"
  data-affordance="origin"
  data-origin-cue
>
  <span class="widget-origin-glint" aria-hidden="true">
    <span class="widget-origin-glint-core"></span>
  </span>
</a>
