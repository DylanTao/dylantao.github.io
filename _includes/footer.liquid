{% capture footer_contents %}
  <nav class="footer-links" aria-label="Site links">
    <a href="{{ '/feed.xml' | relative_url }}">RSS</a>
    {% if site.data.socials.github_username %}
      <a href="https://github.com/{{ site.data.socials.github_username }}" rel="me noopener">GitHub</a>
    {% endif %}
    {% if site.data.socials.email %}
      <a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a>
    {% endif %}
    <a href="{{ '/ai/' | relative_url }}">AI-readable profile</a>
  </nav>
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  <a class="mobile-back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
