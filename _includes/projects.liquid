{% assign project_status_label = project.status | default: '' %}
{% if project_status_label == 'Published' or project_status_label == 'Accepted' %}
  {% assign project_status_label = '' %}
{% endif %}

{% assign project_media_classes = 'project-card-media' %}
{% if project.card_image_fit == 'cover' %}
  {% assign project_media_classes = project_media_classes | append: ' project-card-media-cover' %}
{% endif %}
{% if project.redirect %}
  {% assign project_href = project.redirect %}
  {% assign project_cta_label = 'Visit project site' %}
  {% assign project_cta_icon = 'fa-arrow-up-right-from-square' %}
{% else %}
  {% assign project_href = project.url | relative_url %}
  {% assign project_cta_label = 'Read project page' %}
  {% assign project_cta_icon = 'fa-arrow-right' %}
{% endif %}
{% assign project_card_id = project.title | slugify | prepend: 'project-card-' %}
{% assign project_file_slug = project.slug
  | default: project.name
  | default: project.path
  | default: project.title
  | split: '/'
  | last
  | replace: '.md', ''
  | slugify
%}
{% assign project_card_data = site.data.project_cards[project_file_slug] %}
{% assign project_card_image_sizes = '250px' %}
{% if page.project_cards_interactive %}
  {% assign project_card_image_sizes = '(min-width: 992px) 32vw, (min-width: 768px) 45vw, 92vw' %}
{% endif %}
{% comment %}
  Decks (2026-10-18): a project whose children name it as `parent` is a deck on the projects index.
  Its card opens into a banner with the children fanned out below it (assets/js/project-decks.mjs).
  `deck_children: record` lists the technical record's experiments instead (the Graphics Lab).
  Cards inside a closed deck load their pictures lazily; the root level stays eager.
{% endcomment %}
{% assign project_deck_depth = include.deck_depth | default: 1 %}
{% assign project_card_loading = 'eager' %}
{% if project_deck_depth > 1 %}
  {% assign project_card_loading = 'lazy' %}
{% endif %}
{% assign project_deck_size = 0 %}
{% assign project_deck_experiments = 0 %}
{% assign project_deck_record = null %}
{% assign project_deck_inside = '' | split: '' %}
{% if page.project_cards_interactive %}
  {% if project.deck_children == 'record' %}
    {% comment %} A system kept off the lab's rows with a write-up of its own (Performance) adds one card, not an experiment. {% endcomment %}
    {% assign project_deck_record = site.data.design_records[project_file_slug] %}
    {% for system in project_deck_record.systems %}
      {% if system.index == false %}
        {% if system.page %}
          {% assign project_deck_size = project_deck_size | plus: 1 %}
        {% endif %}
      {% else %}
        {% assign project_deck_size = project_deck_size | plus: system.techniques.size %}
        {% assign project_deck_experiments = project_deck_experiments | plus: system.techniques.size %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% assign project_deck_kids = site.projects | where: 'parent', project_file_slug %}
    {% assign project_deck_size = project_deck_kids.size %}
    {% comment %}
      What the deck holds, named on its face (2026-10-19: Sirui could not find the graphics work two decks down).
      Branches come first, each followed by what it holds two levels down (the 3D home, the Graphics Lab, its pages),
      then the other children, newest first. The face links the first six.
    {% endcomment %}
    {% if project_deck_size > 0 %}
      {% assign inside_kids = site.projects | where: 'parent', project_file_slug | sort: 'debut_date' | reverse %}
      {% assign inside_branches = '' | split: '' %}
      {% assign inside_leaves = '' | split: '' %}
      {% for inside_kid in inside_kids %}
        {% assign inside_grandkids = site.projects | where: 'parent', inside_kid.slug %}
        {% if inside_grandkids.size > 0 %}
          {% assign inside_branches = inside_branches | push: inside_kid %}
        {% else %}
          {% assign inside_leaves = inside_leaves | push: inside_kid %}
        {% endif %}
      {% endfor %}
      {% for inside_kid in inside_branches %}
        {% assign project_deck_inside = project_deck_inside | push: inside_kid %}
        {% assign inside_second = site.projects | where: 'parent', inside_kid.slug | sort: 'debut_date' | reverse %}
        {% for inside_second_item in inside_second %}
          {% assign project_deck_inside = project_deck_inside | push: inside_second_item %}
          {% assign inside_third = site.projects | where: 'parent', inside_second_item.slug | sort: 'debut_date' | reverse %}
          {% for inside_third_item in inside_third %}
            {% assign project_deck_inside = project_deck_inside | push: inside_third_item %}
          {% endfor %}
        {% endfor %}
      {% endfor %}
      {% for inside_kid in inside_leaves %}
        {% assign project_deck_inside = project_deck_inside | push: inside_kid %}
      {% endfor %}
    {% endif %}
  {% endif %}
{% endif %}
{% capture project_card_figure_markup %}
  {% if project.img %}
    {% if project_card_data.mobile_teaser %}
      {% assign project_img_path = project.img
        | remove: '.jpg'
        | remove: '.jpeg'
        | remove: '.png'
        | remove: '.tiff'
        | remove: '.gif'
      %}
      {% assign project_img_parts = project.img | split: '.' %}
      {% assign project_img_ext = project_img_parts.last %}
      <figure>
        <picture>
          <source
            media="(max-width: 767px)"
            srcset="{{ project_card_data.mobile_teaser | relative_url }}"
            type="image/png"
            data-project-card-mobile-teaser
          >
          {% if site.imagemagick.enabled %}
            {% unless project.card_avoid_scaling %}
              <source
                class="responsive-img-srcset"
                {% if project_img_ext == 'gif'
                  or project_img_ext == 'jpeg'
                  or project_img_ext == 'jpg'
                  or project_img_ext == 'png'
                  or project_img_ext == 'tiff'
                %}
                  srcset="{% for width in site.imagemagick.widths %}{{ project_img_path | relative_url }}-{{ width }}.webp {{ width }}w,{% endfor %}"
                  type="image/webp"
                {% else %}
                  srcset="{{ project.img | relative_url }}"
                {% endif %}
                sizes="{{ project_card_image_sizes }}"
              >
            {% endunless %}
          {% endif %}
          <img
            src="{{ project.img | relative_url }}"
            class="card-img-top project-card-img"
            width="100%"
            height="auto"
            alt="{{ project_card_data.teaser_alt | default: project.title | escape }}"
            loading="{{ project_card_loading }}"
            onerror="this.onerror=null; var picture=this.closest('picture'); if (picture) { picture.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); }); }"
          >
        </picture>
      </figure>
    {% elsif page.project_cards_interactive %}
      {% assign project_teaser_alt = project_card_data.teaser_alt | default: project.title %}
      {% include figure.liquid loading=project_card_loading path=project.img sizes="(min-width: 992px) 32vw, (min-width: 768px) 45vw, 92vw" alt=project_teaser_alt class="card-img-top project-card-img" avoid_scaling=project.card_avoid_scaling %}
    {% else %}
      {% include figure.liquid loading="eager" path=project.img sizes="250px" alt="project thumbnail" class="card-img-top project-card-img" avoid_scaling=project.card_avoid_scaling %}
    {% endif %}
  {% endif %}
{% endcapture %}
{% capture project_random_teaser_paths %}
  {% if project_card_data.teasers %}
    {% for teaser in project_card_data.teasers %}
      {% include responsive_variant.liquid path=teaser width=800 %}{% unless forloop.last %}|{% endunless %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% capture project_card_style %}
  {% if project_card_data.accents %}
    --project-accent-morning: {{ project_card_data.accents.morning | default: 'var(--global-theme-color)' }};
    --project-accent-noon: {{ project_card_data.accents.noon | default: 'var(--global-theme-color)' }};
    --project-accent-afternoon: {{ project_card_data.accents.afternoon | default: 'var(--global-theme-color)' }};
    --project-accent-evening: {{ project_card_data.accents.evening | default: 'var(--global-theme-color)' }};
  {% endif %}
{% endcapture %}

{% if page.project_cards_interactive %}
  {% assign card_heading_level = include.heading_level | default: 3 %}
  {% assign project_deck_id = project_file_slug | prepend: 'deck-' %}
  {% capture project_deck_label %}{% if project_deck_record %}{{ project_deck_experiments }} experiments{% elsif project_deck_size == 1 %}{{ project_deck_kids.first.title }}{% else %}{{ project_deck_size }} inside{% endif %}{% endcapture %}
  <article
    class="project-card{% if project_deck_size > 0 %} project-deck{% if include.deck_feature %} project-deck--feature{% endif %}{% endif %}"
    data-project-card
    data-entry
    {% if project_deck_size > 0 %}
      data-project-deck="{{ project_file_slug }}" data-project-deck-size="{{ project_deck_size }}" id="{{ project_deck_id }}"
    {% endif %}
    {% if include.deck_parent %}
      data-project-deck-parent="{{ include.deck_parent }}"
    {% endif %}
    {% if project_card_data.accents %}
      style="{{ project_card_style | strip_newlines | strip }}"
    {% endif %}
  >
    {% if project_deck_size > 0 %}
      {% comment %} The cards inside peek out from under the deck; a feature deck fans a few of them out. {% endcomment %}
      <div class="project-deck-sheets" aria-hidden="true">
        {% if project_deck_record %}
          {% assign project_deck_peeks = '' | split: '' %}
          {% for system in project_deck_record.systems %}
            {% unless system.index == false %}
              {% for technique in system.techniques %}
                {% if technique.thumbnail %}
                  {% assign project_deck_peeks = project_deck_peeks | push: technique.thumbnail.path %}
                {% endif %}
              {% endfor %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {% assign project_deck_peeks = project_deck_kids | sort: 'debut_date' | reverse | map: 'img' %}
        {% endif %}
        {% assign project_deck_peek_count = 2 %}
        {% if include.deck_feature %}
          {% assign project_deck_peek_count = 5 %}
        {% endif %}
        {% for peek in project_deck_peeks limit: project_deck_peek_count %}
          <span
            class="project-deck-sheet"
            style="--sheet-index: {{ forloop.index0 }}; --sheet-image: url('{% include responsive_variant.liquid path=peek width=480 %}');"
          ></span>
        {% endfor %}
      </div>
    {% endif %}
    {% comment %} A deck's card sizes itself (the h-100 utility is a layered !important that would hold an open banner at the deck's full height). {% endcomment %}
    <div class="card{% unless project_deck_size > 0 %} h-100{% endunless %} hoverable">
      <div class="project-card-preview">
        {% if project.img %}
          <div
            class="{{ project_media_classes }}"
            data-entry-media
            {% if project_card_data.teasers %}
              data-random-teaser data-random-teasers="{{ project_random_teaser_paths | strip }}"
            {% endif %}
            {% if project.image_aspect %}
              style="
                --project-image-aspect: {{ project.image_aspect }};
                {% if project.card_image_position %}--project-image-position: {{ project.card_image_position }};{% endif %}
              "
            {% endif %}
          >
            {{ project_card_figure_markup }}
          </div>
        {% endif %}
        <div class="card-body project-card-body">
          <div class="project-card-heading{% if project_card_data.icon %} project-card-heading--with-icon{% endif %}">
            {% include project_card_icon.liquid icon=project_card_data.icon %}
            <h{{ card_heading_level }} class="card-title" data-entry-title>{{ project.title }}</h{{ card_heading_level }}>
          </div>
          {% if project_deck_size > 0 %}
            {% comment %}
              The deck's face names what it holds, each name a link straight to its page; a click between them still
              opens the deck. The Graphics Lab names its record's groups instead, and its write-up.
            {% endcomment %}
            <div class="project-deck-summary{% if project_deck_record %} project-deck-summary--groups{% endif %}">
              <p class="project-deck-count">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 9.5 12 5l8 4.5-8 4.5z" />
                  <path d="m4 13.5 8 4.5 8-4.5" />
                </svg>
                <span>
                  {%- if project_deck_record %}{{ project_deck_label | strip }}{% else %}Inside{% endif -%}
                </span>
              </p>
              <ul class="project-deck-inside" aria-label="Inside {{ project.title | escape }}" data-project-deck-inside>
                {% if project_deck_record %}
                  {% for system in project_deck_record.systems %}
                    {% if system.index == false %}
                      {% if system.page %}
                        <li>
                          <a href="{{ system.page.url | relative_url }}">{{ system.name | smartify }}</a>
                        </li>
                      {% endif %}
                    {% else %}
                      <li>
                        <a href="{{ project.url | relative_url }}#lab-group-{{ system.id }}">{{ system.name | smartify }}</a>
                      </li>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% for inside_item in project_deck_inside limit: 6 %}
                    {% assign inside_card = site.data.project_cards[inside_item.slug] %}
                    <li>
                      <a href="{{ inside_item.url | relative_url }}">{{ inside_card.chip | default: inside_item.title }}</a>
                    </li>
                  {% endfor %}
                  {% if project_deck_inside.size > 6 %}
                    <li class="project-deck-inside-more">and {{ project_deck_inside.size | minus: 6 }} more</li>
                  {% endif %}
                {% endif %}
              </ul>
            </div>
          {% endif %}
          {% if project.venue or project.year or project.role or project_status_label != '' %}
            <p class="project-card-meta">
              {% if project.venue %}
                <span>{{ project.venue }}</span>
              {% elsif project.year %}
                <span>{{ project.year }}</span>
              {% endif %}
              {% if project.role %}
                <span>{{ project.role }}</span>
              {% endif %}
              {% if project_status_label != '' %}
                <span>{{ project_status_label }}</span>
              {% endif %}
            </p>
          {% endif %}
          <p class="card-text">{{ project.description }}</p>
          <a
            class="project-card-direct-link"
            href="{{ project_href }}"
            {% if project.redirect %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{ project_cta_label }}
            <i class="fa-solid {{ project_cta_icon }}" aria-hidden="true"></i>
          </a>
          {% comment %}
            An open card's story is one labelled list (2026-10-19): why it began, what changed and the intended
            outcome share one flat inset instead of three differently ruled boxes.
          {% endcomment %}
          {% if project_card_data.origin_line %}
            <div class="project-card-story" data-project-card-story>
              <div class="project-card-story-beat" data-project-card-origin>
                <p class="project-card-story-label">Why it began</p>
                <p>{{ project_card_data.origin_line }}</p>
              </div>
              {% if project_card_data.evolution_line %}
                <div class="project-card-story-beat" data-project-card-evolution>
                  <p class="project-card-story-label">What changed</p>
                  <p>{{ project_card_data.evolution_line }}</p>
                </div>
              {% endif %}
              {% if project_card_data.takeaways %}
                <div class="project-card-takeaways project-card-outcome" aria-label="{{ project.title }} intended outcome">
                  <p class="project-card-takeaways-label">Intended outcome</p>
                  <p>{{ project_card_data.takeaways.first }}</p>
                </div>
              {% endif %}
            </div>
          {% elsif project_card_data.takeaways %}
            <div class="project-card-takeaways" aria-label="{{ project.title }} takeaways">
              <p class="project-card-takeaways-label">What to notice</p>
              <ul>
                {% for takeaway in project_card_data.takeaways limit: 2 %}
                  <li>{{ takeaway }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          <span class="project-card-preview-affordance" aria-hidden="true">
            {% if project_deck_size > 0 %}
              <i class="fa-solid fa-layer-group"></i>
            {% else %}
              <i class="fa-solid fa-plus"></i>
            {% endif %}
          </span>
        </div>
        {% if project_deck_size > 0 %}
          <button
            class="project-card-trigger project-deck-trigger"
            type="button"
            data-project-deck-trigger
            aria-expanded="false"
            aria-controls="{{ project_deck_id }}-children"
            aria-label="Open {{ project.title }}: {{ project_deck_label | strip }}"
          ></button>
        {% else %}
          <button
            class="project-card-trigger"
            type="button"
            data-project-card-trigger
            aria-expanded="false"
            aria-controls="{{ project_card_id }}-panel"
            aria-label="Preview {{ project.title }}"
          ></button>
        {% endif %}
      </div>

      <div class="project-card-panel" id="{{ project_card_id }}-panel" data-project-card-panel hidden>
        <div class="project-card-actions project-card-actions-expanded">
          <a
            class="project-card-open-link"
            href="{{ project_href }}"
            data-project-card-primary-action
            {% if project.redirect %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            <span>{{ project_cta_label }}</span>
            <i class="fa-solid {{ project_cta_icon }}" aria-hidden="true"></i>
          </a>
          {% if project.github %}
            <a
              class="project-card-action-link project-card-secondary-link"
              href="{{ project.github }}"
              target="_blank"
              rel="noopener noreferrer"
              data-toggle="tooltip"
              title="Code Repository"
            >
              <i class="fa-brands fa-github gh-icon" aria-hidden="true"></i>
              <span>Code</span>
            </a>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          {% endif %}
        </div>
        {% if project_deck_size > 0 %}
          <button class="project-card-close project-deck-close" type="button" data-project-deck-close aria-label="Close {{ project.title }}">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        {% else %}
          <button class="project-card-close" type="button" data-project-card-close aria-label="Close {{ project.title }} preview">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        {% endif %}
      </div>
    </div>
    {% if project_deck_size > 0 %}
      {% comment %}
        The children render last: an include's assignments are global in Liquid, so nothing in this card may read
        them after the recursive includes below. Each pass recomputes its parameters from include.*, which is scoped.
      {% endcomment %}
      <div
        class="project-deck-children"
        id="{{ project_deck_id }}-children"
        data-project-deck-children="{{ project_file_slug }}"
        role="group"
        aria-label="Inside {{ project.title }}"
        hidden="until-found"
      >
        <p class="project-deck-position" aria-hidden="true"><span data-project-deck-position>1</span> / {{ project_deck_size }}</p>
        {% if project_deck_record %}
          {% include graphics_lab.liquid part="deck" heading_level=card_heading_level %}
        {% else %}
          {% assign project_deck_kids = site.projects | where: 'parent', project_file_slug | sort: 'debut_date' | reverse %}
          <div class="project-card-grid" data-project-card-grid>
            {% for project in project_deck_kids %}
              {% assign project_child_level = include.heading_level | default: 3 | plus: 1 %}
              {% if project_child_level > 6 %}
                {% assign project_child_level = 6 %}
              {% endif %}
              {% assign project_child_depth = include.deck_depth | default: 1 | plus: 1 %}
              {% assign project_child_feature = false %}
              {% if forloop.length == 1 %}
                {% assign project_child_feature = true %}
              {% endif %}
              {% include projects.liquid heading_level=project_child_level deck_depth=project_child_depth deck_parent=project.parent deck_feature=project_child_feature %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </article>
{% else %}
  <div class="col">
    <div class="card h-100 hoverable">
      <a
        class="project-card-link"
        href="{{ project_href }}"
        {% if project.redirect %}
          target="_blank" rel="noopener noreferrer"
        {% endif %}
      >
        {% if project.img %}
          <div
            class="{{ project_media_classes }}"
            {% if project_card_data.teasers %}
              data-random-teaser data-random-teasers="{{ project_random_teaser_paths | strip }}"
            {% endif %}
            {% if project.image_aspect %}
              style="
                --project-image-aspect: {{ project.image_aspect }};
                {% if project.card_image_position %}--project-image-position: {{ project.card_image_position }};{% endif %}
              "
            {% endif %}
          >
            {{ project_card_figure_markup }}
          </div>
        {% endif %}
        <div class="card-body">
          <h2 class="card-title">{{ project.title }}</h2>
          {% if project.venue or project.year or project.role or project_status_label != '' %}
            <p class="project-card-meta">
              {% if project.venue %}
                <span>{{ project.venue }}</span>
              {% elsif project.year %}
                <span>{{ project.year }}</span>
              {% endif %}
              {% if project.role %}
                <span>{{ project.role }}</span>
              {% endif %}
              {% if project_status_label != '' %}
                <span>{{ project_status_label }}</span>
              {% endif %}
            </p>
          {% endif %}
          <p class="card-text">{{ project.description }}</p>
        </div>
      </a>
      {% if project.github %}
        <div class="project-card-actions">
          <a
            class="project-card-action-link"
            href="{{ project.github }}"
            target="_blank"
            rel="noopener noreferrer"
            data-toggle="tooltip"
            title="Code Repository"
          >
            <i class="fa-brands fa-github gh-icon" aria-hidden="true"></i>
            <span class="sr-only">Code Repository</span>
          </a>
          {% if project.github_stars %}
            <span class="stars" data-toggle="tooltip" title="GitHub Stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
