<section id="taste" class="home-section home-thesis home-reveal" data-home-section="taste" aria-labelledby="home-thesis-title">
  <div class="home-thesis-grid">
    <div class="home-thesis-copy">
      <div class="home-section-heading">
        <p class="home-kicker">{{ page.thesis.eyebrow | default: 'Thesis thread' }}</p>
        <h2 id="home-thesis-title">{{ page.thesis.title | default: 'Taste is a research problem.' }}</h2>
      </div>
      <p class="home-thesis-lead">
        {{
          page.thesis.lead
          | default: 'When AI can generate ten options in a minute, the hard part is not getting more options. It is learning what differs, what matters, and why one direction is worth pursuing.'
        }}
      </p>
    </div>
    <div class="home-thesis-context">
      <aside class="home-thesis-note" aria-label="Sirui's design principle">
        <span>{{ page.thesis.principle_label | default: 'Design principle' }}</span>
        <p>
          {{
            page.thesis.principle
            | default: 'Good interfaces should make comparison easier: show what changed, what evidence exists, and which decision comes next.'
          }}
        </p>
      </aside>
      {% if page.thesis.domain_note %}
        <p class="home-thesis-domain">{{ page.thesis.domain_note }}</p>
      {% endif %}
      {% if page.thesis.origin %}
        <div class="home-thesis-origin">
          {% if page.thesis.origin.label %}
            <span class="home-thesis-origin-label">{{ page.thesis.origin.label }}</span>
          {% endif %}
          <p class="home-thesis-origin-text">{{ page.thesis.origin.text }}</p>
          <a href="{{ page.thesis.origin.url | relative_url }}">{{ page.thesis.origin.link_label | default: 'Read the note' }} ↗</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
