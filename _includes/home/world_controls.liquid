<div class="home-world-immersive-bar" data-world-immersive-bar hidden>
  <button type="button" class="home-world-exit" data-world-exit>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    <span>Back to the site</span>
    <kbd aria-hidden="true">Esc</kbd>
  </button>
  <button type="button" class="home-world-walk" data-world-walk aria-pressed="false" aria-keyshortcuts="V" title="Walk around (V)">
    <i class="fa-solid fa-person-walking" aria-hidden="true"></i>
    <span>Walk</span>
    <kbd aria-hidden="true">V</kbd>
  </button>
  <button type="button" class="home-world-walk home-world-jump" data-world-jump hidden aria-keyshortcuts="Space" title="Jump (Space)">
    <span>Jump ↑</span><kbd aria-hidden="true">Space</kbd>
  </button>
  <button type="button" class="home-world-walk home-world-ladder" data-world-ladder hidden aria-keyshortcuts="L" title="Roll library ladder (L)">
    Roll ladder
  </button>
</div>
<div class="home-world-controls" data-home-world-controls hidden inert>
  <div class="home-world-status">
    <p data-world-status role="status" aria-live="polite" aria-atomic="true">Opening the little home…</p>
    <div
      class="home-world-progress"
      data-world-progress
      role="progressbar"
      aria-label="Loading the 3D home"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span data-progress-step="house"></span><span data-progress-step="coast"></span><span data-progress-step="room"></span
      ><span data-progress-step="sirui"></span><span data-progress-step="view"></span>
    </div>
    <span class="home-world-clock" data-world-clock>San Diego time</span>
  </div>
  <div class="home-world-quiet-actions">
    <button type="button" data-world-view>Look around <span aria-hidden="true">↗</span></button>
    <button type="button" class="home-world-fullscreen" data-world-fullscreen aria-label="Full screen" title="Full screen (F)">
      <i class="fa-solid fa-expand" aria-hidden="true"></i><span class="home-world-fullscreen-label" aria-hidden="true">Full screen</span>
    </button>
  </div>
  <details class="home-world-explore" data-world-lab hidden inert>
    <summary aria-label="Explore the home" title="Explore the home"><span aria-hidden="true">⋯</span></summary>
    <div class="home-world-panel">
      <div class="home-world-shortcuts">
        <button type="button" data-world-room="overview">Whole home</button>
        <button type="button" data-world-room="outside">Step outside</button>
        <button type="button" data-world-now>Now <span aria-hidden="true">↗</span></button>
        <button type="button" data-world-pause aria-pressed="false" aria-label="Pause motion" title="Pause motion">
          <i class="fa-solid fa-pause" aria-hidden="true"></i>
        </button>
      </div>
      <div class="home-world-room-list" data-world-room-list aria-label="Visit a room"></div>
      <div class="home-world-fields">
        <label
          >Sirui
          <select data-world-avatar aria-label="Choose Sirui’s character"></select
        ></label>
        <label
          >Activity
          <select data-world-activity aria-label="Preview an activity"></select
        ></label>
      </div>
      <label class="home-world-time"
        >A different hour <input data-world-time type="range" min="0" max="1439" step="1" value="720" aria-label="Preview San Diego time"
      ></label>
      <p class="home-world-note">An imagined daily rhythm, on San Diego time. Explore freely; Now brings you back.</p>
      <details class="home-world-objects">
        <summary>Graphics studies</summary>
        <p>Pause motion and choose a preview hour for a still photo. Ink studies render the static geometry separately.</p>
        <button type="button" data-world-photo>Take an 8-sample photo</button>
        <button type="button" data-world-ink>Compare ink studies</button>
        <p data-world-study-status role="status" aria-live="polite"></p>
        <div data-world-study-output></div>
      </details>
      <details class="home-world-objects">
        <summary>Albums & research papers</summary>
        <p>Choose once to inspect, again to play the record or open the paper.</p>
        <div data-world-desk-items></div>
        <button type="button" data-world-drop>Discover a record card</button>
      </details>
      <div class="home-world-camera-actions" aria-label="Camera zoom">
        <button type="button" data-world-zoom="in">Zoom in <span aria-hidden="true">+</span></button>
        <button type="button" data-world-zoom="out">Zoom out <span aria-hidden="true">−</span></button>
      </div>
    </div>
  </details>
</div>
