{% comment %}
  An orange sun above the Pacific current. Sirui asked for an abstract mark with less literal
  fruit detail. The same two shapes are shared with the favicon on a 32-unit grid. The sun dips
  behind the level horizon on focus/hover; reduced motion holds it still. The 404 fruit is separate.
{% endcomment %}
<span class="site-brand-mark brand-orange" data-brand-orange aria-hidden="true">
  <svg class="brand-orange-svg" viewBox="0 0 32 32" focusable="false" aria-hidden="true">
    <defs>
      <clipPath id="brand-orange-horizon"><path d="M0 0H32V19H0Z"></path></clipPath>
    </defs>
    <g clip-path="url(#brand-orange-horizon)">
      <g class="brand-orange-sun">
        <path class="brand-orange-body" d="M3 17C3 9.268 8.82 3 16 3S29 9.268 29 17C29 17.7 28.95 18.4 28.85 19H3.15C3.05 18.4 3 17.7 3 17Z"></path>
      </g>
    </g>
    <path class="brand-orange-sea" d="M1 21H31C24 21 24 28 16 28H5C12 28 12 24 19 24H1Z"></path>
  </svg>
</span>
