{% comment %}
  The site mark: an orange that is also the sun going down into the Pacific below the house. It is
  the same on every visit; the favicon set in assets/img draws the same idea on a 16-pixel grid
  (docs/material-lite-revamp.md, Brand Mark). One curved sea cut crosses a flat orange disk. The
  sea stays level while the sun dips a little on hover or focus.
{% endcomment %}
<span class="site-brand-mark brand-orange" data-brand-orange aria-hidden="true">
  <svg class="brand-orange-svg" viewBox="0 0 16 16" focusable="false" aria-hidden="true">
    <defs>
      <mask id="brand-orange-sea" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
        <rect width="16" height="16" fill="#fff"></rect>
        <path d="M0 11C3 10 5 12 8 11S13 12 16 11V12.5C13 13.5 11 11.5 8 12.5S3 11.5 0 12.5Z" fill="#000"></path>
      </mask>
    </defs>
    <g class="brand-orange-crown">
      <path class="brand-orange-stem" d="M8.1 4C8.05 3.25 8.3 2.55 8.8 2"></path>
      <g class="brand-orange-leaf-group">
        <path class="brand-orange-leaf" d="M8.6 2.8C9.2 1.1 11.3.5 13.4 1C12.7 2.7 10.5 3.5 8.6 2.8Z"></path>
      </g>
    </g>
    <g mask="url(#brand-orange-sea)">
      <g class="brand-orange-body-shell">
        <circle class="brand-orange-body" cx="8" cy="9.3" r="6"></circle>
      </g>
    </g>
  </svg>
</span>
