---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign post_classes = 'post' %}
{% if page.collection == 'projects' %}
  {% assign post_classes = post_classes | append: ' project-detail' %}
  {% if page.hide_title %}
    {% assign post_classes = post_classes | append: ' project-case-page' %}
  {% endif %}
{% endif %}
{% if page.design_story_class %}
  {% assign post_classes = post_classes | append: ' ' | append: page.design_story_class %}
{% endif %}
{% if page.cinematic %}
  {% assign post_classes = post_classes | append: ' cinematic' %}
{% endif %}

<div class="{{ post_classes }}">
  {% unless page.hide_title %}
    <header class="post-header">
      {% comment %} `title` doubles as the lowercase navbar label; `display_title` lets the page heading use sentence case. {% endcomment %}
      <h1 class="post-title">{{ page.display_title | default: page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endunless %}

  <article>
    {{ content }}

    {% comment %}
      Cited references belong to the article: they share its reading column and come before the
      end-of-page project navigation.
    {% endcomment %}
    {% if page.related_publications %}
      {% capture cited_publications %}{% bibliography --group_by none --cited_in_order %}{% endcapture %}
      {% if cited_publications contains 'publication-lens-entry' %}
        <h2>References</h2>
        <div class="publications">
          {{ cited_publications }}
        </div>
      {% endif %}
    {% endif %}
  </article>

  {% if page.collection == 'projects' %}
    {% comment %}
      Previous/next follow the projects index order for this category: research by
      importance, site experiments by debut date (newest first), other playful
      builds by importance. Projects that redirect elsewhere are skipped. A project
      with a parent (a Graphics Lab experiment) moves among its parent's children,
      and its middle link returns to the parent instead of the index.
    {% endcomment %}
    {% assign project_parent = null %}
    {% if page.parent %}
      {% assign project_parent = site.projects | where_exp: 'item', 'item.slug == page.parent' | first %}
    {% endif %}
    {% assign project_siblings = site.projects | where: 'category', page.category | where_exp: 'item', 'item.redirect == nil' %}
    {% if project_parent %}
      {% assign project_siblings = project_siblings | where: 'parent', page.parent | sort: 'debut_date' | reverse %}
    {% elsif page.category == 'fun' %}
      {% assign project_siblings = project_siblings | where_exp: 'item', 'item.parent == nil' %}
      {% if page.site_experiment %}
        {% assign project_siblings = project_siblings | where: 'site_experiment', true | sort: 'debut_date' | reverse %}
      {% else %}
        {% assign project_siblings = project_siblings | where_exp: 'item', 'item.site_experiment != true' | sort: 'importance' %}
      {% endif %}
    {% else %}
      {% assign project_siblings = project_siblings | where_exp: 'item', 'item.parent == nil' | sort: 'importance' %}
    {% endif %}
    {% assign project_previous = null %}
    {% assign project_next = null %}
    {% for sibling in project_siblings %}
      {% if sibling.url == page.url %}
        {% if forloop.index0 > 0 %}
          {% assign previous_index = forloop.index0 | minus: 1 %}
          {% assign project_previous = project_siblings[previous_index] %}
        {% endif %}
        {% unless forloop.last %}
          {% assign next_index = forloop.index0 | plus: 1 %}
          {% assign project_next = project_siblings[next_index] %}
        {% endunless %}
        {% break %}
      {% endif %}
    {% endfor %}
    <nav class="blog-post-navigation project-navigation" aria-label="More projects">
      <div class="blog-nav-chronology">
        {% if project_previous %}
          <a class="blog-nav-direction blog-nav-direction-older" href="{{ project_previous.url | relative_url }}">
            <span class="blog-nav-direction-label">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              Previous project
            </span>
            <span class="blog-nav-direction-title">{{ project_previous.title }}</span>
          </a>
        {% endif %}
        {% if project_parent %}
          <a class="blog-nav-direction project-nav-index" href="{{ project_parent.url | relative_url }}">
            <span class="blog-nav-direction-label">Part of</span>
            <span class="blog-nav-direction-title">{{ project_parent.title }}</span>
          </a>
        {% else %}
          <a class="blog-nav-direction project-nav-index" href="{{ '/projects/' | relative_url }}#{{ page.category }}">
            <span class="blog-nav-direction-label">All projects</span>
            <span class="blog-nav-direction-title">{{ page.category | capitalize }}</span>
          </a>
        {% endif %}
        {% if project_next %}
          <a class="blog-nav-direction blog-nav-direction-newer" href="{{ project_next.url | relative_url }}">
            <span class="blog-nav-direction-label">
              Next project
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </span>
            <span class="blog-nav-direction-title">{{ project_next.title }}</span>
          </a>
        {% endif %}
      </div>
    </nav>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
