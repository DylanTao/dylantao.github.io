---
layout: default
---
<div class="post">
  <header class="post-header">
    <a class="archive-return" href="{{ '/blog/' | relative_url }}"><span aria-hidden="true">←</span> All notes</a>
    {% if page.type == 'categories' %}
      <h1 class="post-title">
        {% include icon.liquid name='tag' class='site-icon--heading' %}
        {{ page.title }}
      </h1>
      <p class="post-description">an archive of {{ page.collection_name }} in this category</p>
    {% elsif page.type == 'year' %}
      <h1 class="post-title">
        {% include icon.liquid name='calendar' class='site-icon--heading' %}
        {{ page.date | date: '%Y' }}
      </h1>
      <p class="post-description">an archive of {{ page.collection_name }} from this year</p>
    {% elsif page.type == 'tags' %}
      <h1 class="post-title">
        {% include icon.liquid name='hash' class='site-icon--heading' %}
        {{ page.title }}
      </h1>
      <p class="post-description">an archive of {{ page.collection_name }} with this tag</p>
    {% endif %}
  </header>

  <article class="archive">
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for document in page.documents %}
          <tr>
            <th scope="row">
              {% if page.type == 'year' %}
                <time datetime="{{ document.date | date_to_xmlschema }}">{{ document.date | date: '%b %d' }}</time>
              {% else %}
                <time datetime="{{ document.date | date_to_xmlschema }}">{{ document.date | date: '%b %d, %Y' }}</time>
              {% endif %}
            </th>
            <td>
              {% if document.redirect == blank %}
                <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
              {% elsif document.redirect contains '://' %}
                <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
              {% else %}
                <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </article>
</div>
