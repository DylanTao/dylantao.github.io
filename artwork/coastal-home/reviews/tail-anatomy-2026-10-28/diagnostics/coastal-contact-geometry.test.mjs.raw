import test from "node:test";
import assert from "node:assert/strict";
import { cloudDistance, createPointIndex } from "../bin/coastal_contact_geometry.mjs";

test("actual geometry binding stays strict when quantization moves a point across the2mm witness band", () => {
  const native = [[0, 0, 0], [0, 0.00199, 0], [0.000528, 0.002, 0]];
  const decoded = [[0, 0, 0], [0, 0.00199, 0], [0.000528, 0.00201, 0]];
  assert.ok(cloudDistance(native.filter((p) => p[1] <= 0.002), decoded.filter((p) => p[1] <= 0.002)) > 0.0005);
  assert.ok(Math.abs(cloudDistance(native, decoded) - 0.00001) < 1e-15);
  const displaced = decoded.map((point) => point.map((value, axis) => value + (axis === 2 ? 0.001 : 0)));
  assert.ok(cloudDistance(native, displaced) > 0.0005, "actual geometry error still exceeds the unchanged gate");
});

test("point index agrees with exhaustive Euclidean distances and rejects absent geometry", () => {
  const points = Array.from({ length: 73 }, (_, i) => [Math.sin(i), Math.cos(i * 2), i / 73]);
  const nearest = createPointIndex(points);
  for (const point of [[0.1, 0.2, 0.3], [-2, 1, 0], [0, 0, 0]]) assert.ok(Math.abs(nearest(point) - Math.min(...points.map((target) => Math.hypot(...target.map((v, i) => v - point[i]))))) < 1e-14);
  assert.throws(() => createPointIndex([]), /geometry is required/);
});
